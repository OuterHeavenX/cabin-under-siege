    "deploy": "node tools/build.mjs && npx wrangler deploy",
    "desktop": "node tools/build-desktop.mjs",
    "desktop:win": "node tools/build-desktop.mjs --win"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  },
